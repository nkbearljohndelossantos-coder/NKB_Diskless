@echo off
cd /d "c:\Users\earlj\Desktop\NKB Diskless System Management"
echo Checking prod_temp.vhdx...
tools\qemu10\qemu-img.exe check -r all "C:\NKB-PoC\disks\virtual\prod_temp.vhdx"
echo Converting to prod_2.vhd...
if exist "C:\NKB-PoC\disks\virtual\prod_2.vhd" del /f /q "C:\NKB-PoC\disks\virtual\prod_2.vhd"
tools\qemu10\qemu-img.exe convert -f vhdx -O vpc -o subformat=dynamic "C:\NKB-PoC\disks\virtual\prod_temp.vhdx" "C:\NKB-PoC\disks\virtual\prod_2.vhd"
echo Cleaning up temp file...
del /f /q "C:\NKB-PoC\disks\virtual\prod_temp.vhdx"
echo Starting iSCSI daemon...
start "" "bin\nkb-iscsi.exe" -target "iqn.2026-11.com.nkb:client-2800afa844cc" -vhd "C:\NKB-PoC\disks\virtual\prod_2.vhd" -port 3260
echo DONE!
